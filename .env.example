# Copy to .env and fill in. .env is gitignored -- never commit real credentials.
WQB_EMAIL=you@example.com
WQB_PASSWORD=your-brain-password

# Optional overrides
# WQB_API_BASE=https://api.worldquantbrain.com
# WQB_MIN_SHARPE=1.25
# WQB_MIN_FITNESS=1.0
# WQB_DATA_DIR=data

# Optional: only needed for `python -m wqb propose` (Claude alpha hypotheses).
# Install the SDK with: pip install -r requirements-optional.txt
# ANTHROPIC_API_KEY=sk-ant-...
